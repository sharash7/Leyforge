{
  "$comment": "Proof-specific completion, derivation, attestation, identity, evidence, masked adjudication, renderer support, and production-ingestion law is enforced by tools.r7_w4_repair.human_review.",
  "$id": "https://leyforge.local/schemas/prd07-w4-human-review-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attestation": {
      "type": "object"
    },
    "criteria": {
      "minItems": 1,
      "type": "array"
    },
    "evidence_references": {
      "type": "array"
    },
    "identity_allocation_started": {
      "const": false
    },
    "identity_binding": {
      "type": "object"
    },
    "judgement": {
      "enum": [
        "PENDING",
        "FAIL-OBSERVED",
        "INCONCLUSIVE",
        "PASS-OBSERVED"
      ]
    },
    "proof_id": {
      "enum": [
        "PRD04-PROOF-50",
        "PRD04-PROOF-51",
        "PRD04-PROOF-53"
      ]
    },
    "proof_observation_created": {
      "const": false
    },
    "review_purpose": {
      "enum": [
        "UNASSIGNED",
        "PRODUCTION-HUMAN-REVIEW",
        "SYNTHETIC-VALIDATOR-TEST"
      ]
    },
    "reviewer": {
      "type": "object"
    },
    "schema_version": {
      "const": "prd07-w4-human-review-v2"
    },
    "status": {
      "enum": [
        "PENDING-HUMAN-REVIEW",
        "COMPLETE"
      ]
    }
  },
  "required": [
    "schema_version",
    "proof_id",
    "status",
    "review_purpose",
    "identity_binding",
    "reviewer",
    "evidence_references",
    "criteria",
    "judgement",
    "attestation",
    "proof_observation_created",
    "identity_allocation_started"
  ],
  "title": "Leyforge W4 governed human review",
  "type": "object"
}

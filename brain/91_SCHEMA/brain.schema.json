{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leyforge.local/schema/brain-v1.json",
  "title": "Leyforge Brain record schema",
  "description": "Machine-readable implementation of LF-BRAIN-03 and LF-BRAIN-04 for Brain schema 1.",
  "version": "0.1.0",
  "schema_version": 1,
  "type": "object",
  "required": [
    "brain_schema",
    "id",
    "type",
    "title",
    "status",
    "information_class",
    "created",
    "updated"
  ],
  "properties": {
    "brain_schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "type": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "information_class": {"enum": ["authored", "generated", "derived", "temporary"]},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "authority_domain": {"type": "string"},
    "authority_role": {"type": "string"},
    "authority_status": {"type": "string"}
  },
  "record_types": {
    "home": ["active", "deprecated", "archived"],
    "index": ["active", "deprecated", "archived"],
    "dashboard": ["active", "deprecated", "archived"],
    "system": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "entity": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "concept": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "architecture": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "interface": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "implementation_module": ["proposed", "active", "locked", "deprecated", "superseded", "archived"],
    "document": ["draft", "active", "locked", "certified", "superseded", "retired", "archived"],
    "source": ["active", "historical", "superseded", "unavailable", "archived"],
    "requirement": ["proposed", "active", "implemented", "verified", "deferred", "superseded", "retired"],
    "migration": ["planned", "active", "complete", "failed", "rolled_back", "superseded"],
    "adr": ["proposed", "experimental", "accepted", "superseded", "rejected", "deprecated"],
    "decision": ["proposed", "accepted", "superseded", "rejected"],
    "work": ["planned", "active", "blocked", "complete", "cancelled"],
    "work_item": ["planned", "active", "blocked", "complete", "cancelled"],
    "handoff": ["active", "superseded", "archived"],
    "skill": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "procedure": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "pattern": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "antipattern": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "shortcut": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "lesson": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "failure": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "workaround": ["candidate", "testing", "validated", "deprecated", "rejected", "archived"],
    "research": ["planned", "active", "complete", "superseded", "archived"],
    "finding": ["candidate", "supported", "superseded", "rejected", "archived"],
    "experiment": ["planned", "running", "complete", "failed", "cancelled"],
    "test": ["draft", "active", "deprecated", "superseded"],
    "evidence": ["active", "superseded", "historical", "invalidated", "archived"],
    "benchmark": ["active", "superseded", "historical", "invalidated", "archived"],
    "bug": ["open", "triaged", "in_progress", "fixed", "verified", "deferred", "wont_fix", "duplicate"],
    "risk": ["identified", "active", "mitigated", "accepted", "realised", "closed"],
    "conflict": ["detected", "investigating", "resolved", "deferred"],
    "audit": ["planned", "active", "pass", "fail", "blocked", "deferred", "certified", "superseded"],
    "deviation": ["proposed", "approved", "active", "expired", "resolved", "revoked"],
    "inbox": ["new", "reviewing", "promoted", "merged", "rejected", "archived"]
  },
  "information_classes": ["authored", "generated", "derived", "temporary"],
  "authority_domains": [
    "project_control",
    "content_canon",
    "requirements",
    "engineering_governance",
    "architecture",
    "registry",
    "implementation_state",
    "testing_evidence",
    "research",
    "brain_operations",
    "production",
    "audit"
  ],
  "authority_roles": [
    "primary",
    "delegated",
    "supporting",
    "implementation_record",
    "evidence_record",
    "derived_record",
    "historical_record",
    "provisional_record",
    "none"
  ],
  "authority_statuses": [
    "draft",
    "proposed",
    "theoretically_locked",
    "authoritative",
    "certified",
    "superseded",
    "retired",
    "historical",
    "rejected",
    "unresolved",
    "not_applicable"
  ],
  "relationship_fields": [
    "depends_on",
    "used_by",
    "implements",
    "implemented_by",
    "requirements",
    "architecture",
    "interfaces",
    "tests",
    "tested_by",
    "evidence",
    "evidence_for",
    "decisions",
    "decision_for",
    "risks",
    "blocked_by",
    "mitigates",
    "conflicts_with",
    "related_to",
    "derived_from",
    "generated_from",
    "discovered_in",
    "validated_by"
  ],
  "lineage_fields": [
    "supersedes",
    "superseded_by",
    "amends",
    "amended_by",
    "consolidates",
    "consolidated_into",
    "retires",
    "retired_by"
  ],
  "generated_required": ["generator", "generation_version", "generated_at", "edit_policy"],
  "type_required_fields": {
    "document": ["canonical_path", "source_hash", "source_commit"],
    "requirement": ["verification_method"],
    "implementation_module": ["repository_paths"],
    "test": ["verification_command"],
    "evidence": ["evidence_path", "commit"],
    "work": ["owner"],
    "handoff": ["from_work", "next_gate"],
    "audit": ["profile", "result"]
  },
  "id_patterns": {
    "work": "^WORK-[0-9]{8}-[0-9]{3}$",
    "handoff": "^HANDOFF-[0-9]{8}-[0-9]{3}$",
    "adr": "^ADR-[0-9]{4}$",
    "decision": "^DEC-[0-9]{4}$",
    "skill": "^SKILL-[0-9]{4}$",
    "risk": "^RISK-[0-9]{4}$",
    "conflict": "^CONFLICT-[0-9]{4}$",
    "bug": "^BUG-[0-9]{4}$",
    "audit": "^AUDIT-[0-9]{4}$"
  }
}

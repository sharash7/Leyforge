filters:
  and:
    - file.hasProperty("brain_schema")
    - 'type == "conflict"'
properties:
  id:
    displayName: ID
  status:
    displayName: Status
  authority_domain:
    displayName: Owning Domain
views:
  - type: table
    name: Unresolved Conflicts
    filters:
      and:
        - 'status != "resolved"'
    order:
      - id
      - file.name
      - status
      - authority_domain
